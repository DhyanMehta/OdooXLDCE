# CampusOS API settings (copy to backend/.env)
#
# DATABASE_URL must match the credentials in database/.env:
#   database/.env  →  POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   this file      →  postgresql+psycopg://USER:PASSWORD@localhost:5432/DB
#
# Example correspondence (Docker compose defaults):
#   POSTGRES_USER=campusos
#   POSTGRES_PASSWORD=campusos_dev
#   POSTGRES_DB=campusos
#   DATABASE_URL=postgresql+psycopg://campusos:campusos_dev@localhost:5432/campusos

APP_NAME=CampusOS API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://campusos:campusos_dev@localhost:5432/campusos

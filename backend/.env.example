# CampusOS API settings (copy to backend/.env)
#
# DATABASE_URL must match database/.env credentials.

APP_NAME=CampusOS API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/campusos
SECRET_KEY=campusos-dev-secret-change-me
SESSION_COOKIE_NAME=campusos_session
CSRF_COOKIE_NAME=campusos_csrf
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEMO_PAYMENTS_ENABLED=true
RESERVATION_MINUTES=15
RENEWAL_REMINDER_DAYS=14
EMAIL_ADAPTER=dev
CURRENCY_CODE=INR

# CampusOS API settings (copy to backend/.env)
#
# DATABASE_URL is the single canonical URL for app, worker, seed, and Alembic.
# Accepts postgresql://, postgres://, postgresql+psycopg://, or postgresql+asyncpg://.
# The app normalizes to postgresql+asyncpg:// (never log the full URL).
# Local default applies only when APP_ENV=development|dev|local and DATABASE_URL is unset.
# TEST_DATABASE_URL is required for pytest and must differ from DATABASE_URL.
# Allowed test DB names: campusos_test, campusos_ci_test (must already exist; tests never CREATE DATABASE).

APP_NAME=CampusOS API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/campusos
TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/campusos_test
SECRET_KEY=campusos-dev-secret-change-me
# Optional dedicated AEAD key for QR owner-display credentials (falls back to SECRET_KEY).
# QR_CREDENTIAL_KEY=
SESSION_COOKIE_NAME=campusos_session
CSRF_COOKIE_NAME=campusos_csrf
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Demo payments also require APP_ENV in {development,dev,test,testing,local}; never in production.
DEMO_PAYMENTS_ENABLED=true
RESERVATION_MINUTES=15
RENEWAL_REMINDER_DAYS=14
CHECK_IN_OPEN_MINUTES_BEFORE=60
CHECK_IN_CLOSE_MINUTES_AFTER=120
EMAIL_ADAPTER=dev
# Dev adapter writes previews under backend/app/var/email_outbox (no external send).
# Delivery poll interval (--loop). Reminder scans use a separate interval.
WORKER_INTERVAL_SECONDS=30
WORKER_REMINDER_INTERVAL_SECONDS=300
WORKER_CLAIM_SECONDS=120
CURRENCY_CODE=INR

# Expense receipts are stored on local disk only (no cloud storage). The operator
# must back up RECEIPT_STORAGE_DIR; deleting it orphans attachment rows.
# Default: backend/app/var/receipts. Allowed types: image/jpeg, image/png, application/pdf.
# RECEIPT_STORAGE_DIR=
RECEIPT_MAX_BYTES=5000000

# SQLAlchemy async pool (pool_pre_ping is always enabled)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Set true behind transaction poolers that mishandle prepared statements
# (sets SQLAlchemy prepared_statement_cache_size=0 and asyncpg statement_cache_size=0).
# Does not guarantee compatibility with every pooler/version.
DB_DISABLE_PREPARED_STATEMENT_CACHE=false
# Smaller pool for campusos-worker process
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=2

# Provider SSL example (do not commit real credentials):
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# Transaction pooler hint:
# DATABASE_URL=postgresql://user:pass@pooler-host:5432/db?sslmode=require&disable_prepared_statement_cache=true

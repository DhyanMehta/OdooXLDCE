# CampusOS PostgreSQL settings for Docker Compose (copy to database/.env)
#
# These values must match backend/.env DATABASE_URL:
#   DATABASE_URL=postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
#
# Defaults used in documentation:
#   user     = campusos
#   password = campusos_dev
#   database = campusos
#   → postgresql+psycopg://campusos:campusos_dev@localhost:5432/campusos

POSTGRES_USER=campusos
POSTGRES_PASSWORD=campusos_dev
POSTGRES_DB=campusos

# Used by Alembic (database/migrations/env.py). Keep in sync with backend DATABASE_URL.
DATABASE_URL=postgresql+psycopg://campusos:campusos_dev@localhost:5432/campusos
